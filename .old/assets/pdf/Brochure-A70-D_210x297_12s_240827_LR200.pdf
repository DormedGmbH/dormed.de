         <dc:format>application/pdf</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Studio Standard</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The Studio Profile is a brand profile template for Adobe Indesign. The template is 24pp and designed in both A4 (297x 210mm) and US letter (8.5x11â€). The profile is a cross between an introduction and a portfolio. It outlines who you are, what you do, how you do it, your service list, your staff and everything else a prospective client would need to know about you. Like all Studio Standard templates itâ€™s fully editable, utilizing character, paragraph and object styles for easy customization. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>studio</rdf:li>
               <rdf:li>standard</rdf:li>
               <rdf:li>portfolio</rdf:li>
               <rdf:li>profile</rdf:li>
               <rdf:li>introduction</rdf:li>
