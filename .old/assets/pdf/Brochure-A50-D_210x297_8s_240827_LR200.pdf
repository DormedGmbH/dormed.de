               <rdf:li>entrepreneur</rdf:li>
               <rdf:li>marble</rdf:li>
               <rdf:li>layout</rdf:li>
               <rdf:li>indesign</rdf:li>
               <rdf:li>concrete</rdf:li>
               <rdf:li>instagram</rdf:li>
               <rdf:li>template</rdf:li>
               <rdf:li>adobe</rdf:li>
               <rdf:li>typography</rdf:li>
               <rdf:li>agency</rdf:li>
               <rdf:li>brand</rdf:li>
               <rdf:li>branding</rdf:li>
               <rdf:li>pitch</rdf:li>
               <rdf:li>pack</rdf:li>
               <rdf:li>mail out</rdf:li>
               <rdf:li>mailer</rdf:li>
               <rdf:li>lifestyle</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Â© Studio Standard</rdf:li>
            </rdf:Alt>
